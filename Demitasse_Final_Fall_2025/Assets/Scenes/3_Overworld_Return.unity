  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ma ch\xE8re Pasha Poodl,\r\n\r\n\tI am writing this letter to request
    a favor from one of my most successful proteges I have ever had the pleasure
    of working with. See I am coming into the city in a week's time, you know I do
    not have this opportunity often. So I\u2019d like to see what has changed in
    Paris, though I\u2019d also like to pick up a fragrance from you. If you remember
    the one you had mixed just before parting ways with me to open up shop in the
    city. That, that is the one I would love to get my hands on. It has been a scent
    so dear to me, but it has run its course. Please do not worry if you do not have
    it, I still plan to see you when I arrive.\r\n\r\n\t\t\t\tBien a vous \r\n\t\t\t\tHenri
    Briard\r\n"
  m_isRightToLeft: 0
